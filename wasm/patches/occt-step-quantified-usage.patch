+
+void RWStepRepr_RWQuantifiedNextAssemblyUsageOccurrence::ReadStep(
+  const occ::handle<StepData_StepReaderData>&                        theData,
+  const int                                                          theNum0,
+  occ::handle<Interface_Check>&                                      theCheck,
+  const occ::handle<StepRepr_QuantifiedNextAssemblyUsageOccurrence>& theEnt) const
+{
+  int aNum = 0;
+  theData->NamedForComplex("ASSEMBLY_COMPONENT_USAGE", "ASCMUS", theNum0, aNum, theCheck);
+  occ::handle<TCollection_HAsciiString> aReferenceDesignator;
+  const bool hasReferenceDesignator = theData->CheckNbParams(aNum, 1, theCheck, "assembly_component_usage")
+                                      && theData->IsParamDefined(aNum, 1);
+  if (hasReferenceDesignator)
+  {
+    theData->ReadString(aNum, 1, "reference_designator", theCheck, aReferenceDesignator);
+  }
+
+  theData->NamedForComplex("PRODUCT_DEFINITION_RELATIONSHIP", "PRDFRL", theNum0, aNum, theCheck);
+  if (!theData->CheckNbParams(aNum, 5, theCheck, "product_definition_relationship"))
+  {
+    return;
+  }
+  occ::handle<TCollection_HAsciiString> anId, aName, aDescription;
+  theData->ReadString(aNum, 1, "id", theCheck, anId);
+  theData->ReadString(aNum, 2, "name", theCheck, aName);
+  const bool hasDescription = theData->IsParamDefined(aNum, 3);
+  if (hasDescription)
+  {
+    theData->ReadString(aNum, 3, "description", theCheck, aDescription);
+  }
+  StepBasic_ProductDefinitionOrReference aRelating, aRelated;
+  theData->ReadEntity(aNum, 4, "relating_product_definition", theCheck, aRelating);
+  theData->ReadEntity(aNum, 5, "related_product_definition", theCheck, aRelated);
+  theEnt->Init(anId,
+               aName,
+               hasDescription,
+               aDescription,
+               aRelating,
+               aRelated,
+               hasReferenceDesignator,
+               aReferenceDesignator);
+
+  theData->NamedForComplex("QUANTIFIED_ASSEMBLY_COMPONENT_USAGE", "QACU", theNum0, aNum, theCheck);
+  if (theData->CheckNbParams(aNum, 1, theCheck, "quantified_assembly_component_usage"))
+  {
+    occ::handle<Standard_Transient> aQuantity;
+    theData->ReadEntity(aNum, 1, "quantity", theCheck, STANDARD_TYPE(Standard_Transient), aQuantity);
+    theEnt->SetQuantity(aQuantity);
+  }
+}
+
+//=================================================================================================
+
+void RWStepRepr_RWQuantifiedNextAssemblyUsageOccurrence::WriteStep(
+  StepData_StepWriter&                                               theSW,
+  const occ::handle<StepRepr_QuantifiedNextAssemblyUsageOccurrence>& theEnt) const
+{
+  theSW.StartEntity("ASSEMBLY_COMPONENT_USAGE");
+  if (theEnt->HasReferenceDesignator())
+  {
+    theSW.Send(theEnt->ReferenceDesignator());
+  }
+  else
+  {
+    theSW.SendUndef();
+  }
+  theSW.StartEntity("NEXT_ASSEMBLY_USAGE_OCCURRENCE");
+  theSW.StartEntity("PRODUCT_DEFINITION_RELATIONSHIP");
+  theSW.Send(theEnt->Id());
+  theSW.Send(theEnt->Name());
+  if (theEnt->HasDescription())
+  {
+    theSW.Send(theEnt->Description());
+  }
+  else
+  {
+    theSW.SendUndef();
+  }
+  theSW.Send(theEnt->RelatingProductDefinitionAP242().Value());
+  theSW.Send(theEnt->RelatedProductDefinitionAP242().Value());
+  theSW.StartEntity("PRODUCT_DEFINITION_USAGE");
+  theSW.StartEntity("QUANTIFIED_ASSEMBLY_COMPONENT_USAGE");
+  theSW.Send(theEnt->Quantity());
+}
+
+//=================================================================================================
+
+void RWStepRepr_RWQuantifiedNextAssemblyUsageOccurrence::Share(
+  const occ::handle<StepRepr_QuantifiedNextAssemblyUsageOccurrence>& theEnt,
+  Interface_EntityIterator&                                          theIter) const
+{
+  theIter.AddItem(theEnt->RelatingProductDefinitionAP242().Value());
+  theIter.AddItem(theEnt->RelatedProductDefinitionAP242().Value());
+  theIter.AddItem(theEnt->Quantity());
+}
