+
+//! Representation of the complex instance of next_assembly_usage_occurrence and
+//! quantified_assembly_component_usage (PDM Schema Usage Guide 4.3, 4.1.2): a usage of a component
+//! that stands for Quantity occurrences of it, which are not told apart.
+class StepRepr_QuantifiedNextAssemblyUsageOccurrence : public StepRepr_NextAssemblyUsageOccurrence
+{
+public:
+  //! Empty constructor
+  Standard_EXPORT StepRepr_QuantifiedNextAssemblyUsageOccurrence();
+
+  //! Returns field Quantity (quantified_assembly_component_usage.quantity, a measure_with_unit)
+  const occ::handle<Standard_Transient>& Quantity() const { return myQuantity; }
+
+  //! Set field Quantity
+  void SetQuantity(const occ::handle<Standard_Transient>& theQuantity) { myQuantity = theQuantity; }
+
+  DEFINE_STANDARD_RTTIEXT(StepRepr_QuantifiedNextAssemblyUsageOccurrence,
+                          StepRepr_NextAssemblyUsageOccurrence)
+
+private:
+  occ::handle<Standard_Transient> myQuantity;
+};
