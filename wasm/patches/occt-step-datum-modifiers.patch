+// What a datum reference (compartment or common datum element) gives its datums.
+struct DatumReferenceModifiers
+{
+  NCollection_Sequence<XCAFDimTolObjects_DatumSingleModif>                    Modifiers;
+  XCAFDimTolObjects_DatumModifWithValue                                       ModifWithVal =
+    XCAFDimTolObjects_DatumModifWithValue_None;
+  double                                                                      ModifValue = 0.;
+  NCollection_Sequence<std::pair<XCAFDimTolObjects_DatumSingleModif, gp_Ax1>> SituationFeatures;
+};
+
+// Adds a datum reference's modifiers. A modifier with value whose length has no usable unit is
+// left out.
+static void readDatumModifiers(
+  const occ::handle<NCollection_HArray1<StepDimTol_DatumReferenceModifier>>& theStepModifiers,
+  const StepData_Factors&                                                    theLocalFactors,
+  DatumReferenceModifiers&                                                   theMods)
+{
+  if (theStepModifiers.IsNull())
+  {
+    return;
+  }
+  for (int i = theStepModifiers->Lower(); i <= theStepModifiers->Upper(); i++)
+  {
+    const StepDimTol_DatumReferenceModifier& aModif = theStepModifiers->Value(i);
+    if (aModif.CaseNumber() == 2)
+    {
+      // a value not in the schema is -1
+      const int aValue = aModif.SimpleDatumReferenceModifierMember()->Int();
+      if (aValue >= 0)
+      {
+        theMods.Modifiers.Append((XCAFDimTolObjects_DatumSingleModif)aValue);
+      }
+      continue;
+    }
+    const occ::handle<StepDimTol_DatumReferenceModifierWithValue> aWithVal =
+      aModif.DatumReferenceModifierWithValue();
+    if (aWithVal.IsNull() || aWithVal->ModifierValue().IsNull())
+    {
+      continue;
+    }
+    StepBasic_Unit anUnit = aWithVal->ModifierValue()->UnitComponent();
+    if (anUnit.IsNull() || anUnit.CaseNum(anUnit.Value()) != 1)
+    {
+      continue;
+    }
+    STEPConstruct_UnitContext anUnitCtx;
+    anUnitCtx.ComputeFactors(anUnit.NamedUnit(), theLocalFactors);
+    theMods.ModifWithVal =
+      (XCAFDimTolObjects_DatumModifWithValue)(aWithVal->ModifierType() + 1);
+    theMods.ModifValue =
+      aWithVal->ModifierValue()->ValueComponent() * anUnitCtx.LengthFactor();
+  }
+}
+
+// The factors of a representation's own units, for geometry given in it.
+static StepData_Factors representationFactors(const occ::handle<StepRepr_Representation>&   theRep,
+                                              const occ::handle<Transfer_TransientProcess>& theTP,
+                                              const StepData_Factors& theLocalFactors)
+{
+  StepData_Factors aFactors = theLocalFactors;
+  if (!theRep.IsNull())
+  {
+    XSAlgo_ShapeProcessor::PrepareForTransfer();
+    STEPControl_ActorRead anActor(theTP->Model());
+    anActor.PrepareUnits(theRep, theTP, aFactors);
+  }
+  return aFactors;
+}
+
+// Adds the situation features of a datum reference: the point, line or plane it is related to by
+// a shape_aspect_relationship named 'point/line/plane situation feature', through a geometric
+// item usage (CAx-IF PMI RP Figure 66).
+static void readSituationFeatures(
+  const occ::handle<StepRepr_ShapeAspect>&      theRef,
+  const occ::handle<Transfer_TransientProcess>& theTP,
+  const StepData_Factors&                       theLocalFactors,
+  NCollection_Sequence<std::pair<XCAFDimTolObjects_DatumSingleModif, gp_Ax1>>& theFeatures)
+{
+  const Interface_Graph& aGraph = theTP->Graph();
+  for (Interface_EntityIterator anIter = aGraph.Sharings(theRef); anIter.More(); anIter.Next())
+  {
+    const occ::handle<StepRepr_ShapeAspectRelationship> aSAR =
+      occ::down_cast<StepRepr_ShapeAspectRelationship>(anIter.Value());
+    if (aSAR.IsNull() || aSAR->Name().IsNull() || aSAR->RelatingShapeAspect() != theRef
+        || aSAR->RelatedShapeAspect().IsNull())
+    {
+      continue;
+    }
+    TCollection_AsciiString aName = aSAR->Name()->String();
+    aName.LeftAdjust();
+    aName.RightAdjust();
+    aName.LowerCase();
+    XCAFDimTolObjects_DatumSingleModif aType;
+    if (aName == "point situation feature")
+    {
+      aType = XCAFDimTolObjects_DatumSingleModif_Point;
+    }
+    else if (aName == "line situation feature")
+    {
+      aType = XCAFDimTolObjects_DatumSingleModif_Line;
+    }
+    else if (aName == "plane situation feature")
+    {
+      aType = XCAFDimTolObjects_DatumSingleModif_Plane;
+    }
+    else
+    {
+      continue;
+    }
+    for (Interface_EntityIterator anIterSA = aGraph.Sharings(aSAR->RelatedShapeAspect());
+         anIterSA.More();
+         anIterSA.Next())
+    {
+      const occ::handle<StepAP242_ItemIdentifiedRepresentationUsage> aUsage =
+        occ::down_cast<StepAP242_ItemIdentifiedRepresentationUsage>(anIterSA.Value());
+      if (aUsage.IsNull() || aUsage->IsKind(STANDARD_TYPE(StepAP242_DraughtingModelItemAssociation))
+          || aUsage->NbIdentifiedItem() < 1)
+      {
+        continue;
+      }
+      const occ::handle<StepRepr_RepresentationItem> anItem = aUsage->IdentifiedItemValue(1);
+      const StepData_Factors                         aFactors =
+        representationFactors(aUsage->UsedRepresentation(), theTP, theLocalFactors);
+      gp_Ax1                                         anAxis;
+      bool                                           isRead = false;
+      if (const occ::handle<StepGeom_Plane> aPlane = occ::down_cast<StepGeom_Plane>(anItem))
+      {
+        const occ::handle<Geom_Plane> aGeom = StepToGeom::MakePlane(aPlane, aFactors);
+        isRead = !aGeom.IsNull();
+        anAxis = isRead ? aGeom->Axis() : anAxis;
+      }
+      else if (const occ::handle<StepGeom_Line> aLine = occ::down_cast<StepGeom_Line>(anItem))
+      {
+        const occ::handle<Geom_Line> aGeom = StepToGeom::MakeLine(aLine, aFactors);
+        isRead = !aGeom.IsNull();
+        anAxis = isRead ? aGeom->Position() : anAxis;
+      }
+      else if (const occ::handle<StepGeom_Axis2Placement3d> aPlacement =
+                 occ::down_cast<StepGeom_Axis2Placement3d>(anItem))
+      {
+        const occ::handle<Geom_Axis2Placement> aGeom =
+          StepToGeom::MakeAxis2Placement(aPlacement, aFactors);
+        isRead = !aGeom.IsNull();
+        anAxis = isRead ? aGeom->Ax2().Axis() : anAxis;
+      }
+      else if (const occ::handle<StepGeom_CartesianPoint> aPoint =
+                 occ::down_cast<StepGeom_CartesianPoint>(anItem))
+      {
+        const occ::handle<Geom_CartesianPoint> aGeom =
+          StepToGeom::MakeCartesianPoint(aPoint, aFactors);
+        isRead = !aGeom.IsNull();
+        anAxis = isRead ? gp_Ax1(aGeom->Pnt(), gp::DZ()) : anAxis;
+      }
+      if (isRead)
+      {
+        theFeatures.Append({aType, anAxis});
+        break;
+      }
+    }
+  }
+}
