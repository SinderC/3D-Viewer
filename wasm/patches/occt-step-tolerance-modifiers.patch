     for (int i0 = 1; i0 <= nb0; i0++)
     {
       StepDimTol_GeometricToleranceModifier anIt0 = StepDimTol_GTMMaximumMaterialRequirement;
+      bool                                  isKnown = true;
       if (data->ParamType(num2, i0) == Interface_ParamEnum)
       {
         const char* text = data->ParamCValue(num2, i0);
@@ -163,14 +165,34 @@ void RWStepDimTol_RWGeoTolAndGeoTolWthDatRefAndGeoTolWthMaxTol::ReadStep(
         }
         else
         {
+          isKnown = false;
           ach->AddFail("Parameter #5 (modifiers) has not allowed value");
         }
       }
       else
       {
+        isKnown = false;
         ach->AddFail("Parameter #5 (modifier) is not set of enumerations");
       }
-      aModifiers->SetValue(i0, anIt0);
+      if (isKnown)
+      {
+        aModifiers->SetValue(++aNbKnown, anIt0);
+      }
+    }
+    // Values OCCT has no enumerator for (e.g. the ISO 1101 association modifiers) are dropped,
+    // not read as maximum material requirement
+    if (aNbKnown < nb0)
+    {
+      occ::handle<NCollection_HArray1<StepDimTol_GeometricToleranceModifier>> aKnown;
+      if (aNbKnown > 0)
+      {
+        aKnown = new NCollection_HArray1<StepDimTol_GeometricToleranceModifier>(1, aNbKnown);
+        for (int i = 1; i <= aNbKnown; i++)
+        {
+          aKnown->SetValue(i, aModifiers->Value(i));
