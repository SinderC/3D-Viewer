+
+#include "RWStepRepr_RWMultiLevelReferenceDesignator.pxx"
+#include <Interface_EntityIterator.hxx>
+#include <StepData_StepReaderData.hxx>
+#include <StepData_StepWriter.hxx>
+#include <StepRepr_MultiLevelReferenceDesignator.hxx>
+#include <TCollection_HAsciiString.hxx>
+
+//=================================================================================================
+
+RWStepRepr_RWMultiLevelReferenceDesignator::RWStepRepr_RWMultiLevelReferenceDesignator() = default;
+
+//=================================================================================================
+
+void RWStepRepr_RWMultiLevelReferenceDesignator::ReadStep(
+  const occ::handle<StepData_StepReaderData>&                theData,
+  const int                                                  theNum,
+  occ::handle<Interface_Check>&                              theCheck,
+  const occ::handle<StepRepr_MultiLevelReferenceDesignator>& theEnt) const
+{
+  if (!theData->CheckNbParams(theNum, 7, theCheck, "multi_level_reference_designator"))
+  {
+    return;
+  }
+
+  occ::handle<TCollection_HAsciiString> anId, aName, aDescription, aReferenceDesignator;
+  theData->ReadString(theNum, 1, "product_definition_relationship.id", theCheck, anId);
+  theData->ReadString(theNum, 2, "product_definition_relationship.name", theCheck, aName);
+  const bool hasDescription = theData->IsParamDefined(theNum, 3);
+  if (hasDescription)
+  {
+    theData->ReadString(theNum, 3, "product_definition_relationship.description", theCheck, aDescription);
+  }
+  // 4 and 5, relating and related product definitions, are derived from the location
+  const bool hasReferenceDesignator = theData->IsParamDefined(theNum, 6);
+  if (hasReferenceDesignator)
+  {
+    theData->ReadString(theNum, 6, "reference_designator", theCheck, aReferenceDesignator);
+  }
+
+  occ::handle<NCollection_HArray1<occ::handle<StepRepr_NextAssemblyUsageOccurrence>>> aLocation;
+  int aSub = 0;
+  if (theData->ReadSubList(theNum, 7, "location", theCheck, aSub))
+  {
+    const int aNb = theData->NbParams(aSub);
+    aLocation     = new NCollection_HArray1<occ::handle<StepRepr_NextAssemblyUsageOccurrence>>(1, aNb);
+    for (int i = 1; i <= aNb; i++)
+    {
+      occ::handle<StepRepr_NextAssemblyUsageOccurrence> anUsage;
+      theData->ReadEntity(aSub,
+                          i,
+                          "next_assembly_usage_occurrence",
+                          theCheck,
+                          STANDARD_TYPE(StepRepr_NextAssemblyUsageOccurrence),
+                          anUsage);
+      aLocation->SetValue(i, anUsage);
+    }
+  }
+
+  theEnt->Init(anId,
+               aName,
+               hasDescription,
+               aDescription,
+               hasReferenceDesignator,
+               aReferenceDesignator,
+               aLocation);
+}
+
+//=================================================================================================
+
+void RWStepRepr_RWMultiLevelReferenceDesignator::WriteStep(
+  StepData_StepWriter&                                       theSW,
+  const occ::handle<StepRepr_MultiLevelReferenceDesignator>& theEnt) const
+{
+  theSW.Send(theEnt->Id());
+  theSW.Send(theEnt->Name());
+  if (theEnt->HasDescription())
+  {
+    theSW.Send(theEnt->Description());
+  }
+  else
+  {
+    theSW.SendUndef();
+  }
+  theSW.SendDerived();
+  theSW.SendDerived();
+  if (theEnt->HasReferenceDesignator())
+  {
+    theSW.Send(theEnt->ReferenceDesignator());
+  }
+  else
+  {
+    theSW.SendUndef();
+  }
+  theSW.OpenSub();
+  for (int i = 1; i <= theEnt->NbLocation(); i++)
+  {
+    theSW.Send(theEnt->Location()->Value(i));
+  }
+  theSW.CloseSub();
+}
+
+//=================================================================================================
+
+void RWStepRepr_RWMultiLevelReferenceDesignator::Share(
+  const occ::handle<StepRepr_MultiLevelReferenceDesignator>& theEnt,
+  Interface_EntityIterator&                                  theIter) const
+{
+  for (int i = 1; i <= theEnt->NbLocation(); i++)
+  {
+    theIter.AddItem(theEnt->Location()->Value(i));
+  }
+}
