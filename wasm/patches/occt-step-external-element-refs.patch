+#include "RWStepBasic_RWExternallyDefinedItemWithMultipleReferences.pxx"
+#include <Interface_EntityIterator.hxx>
+#include <StepBasic_ExternallyDefinedItemWithMultipleReferences.hxx>
+#include <StepBasic_ExternalSource.hxx>
+#include <StepData_StepReaderData.hxx>
+#include <StepData_StepWriter.hxx>
+
+//=================================================================================================
+
+RWStepBasic_RWExternallyDefinedItemWithMultipleReferences::
+  RWStepBasic_RWExternallyDefinedItemWithMultipleReferences() = default;
+
+//=================================================================================================
+
+void RWStepBasic_RWExternallyDefinedItemWithMultipleReferences::ReadStep(
+  const occ::handle<StepData_StepReaderData>&                               theData,
+  const int                                                                 theNum,
+  occ::handle<Interface_Check>&                                             theCheck,
+  const occ::handle<StepBasic_ExternallyDefinedItemWithMultipleReferences>& theEnt) const
+{
+  if (!theData->CheckNbParams(theNum, 3, theCheck, "externally_defined_item_with_multiple_references"))
+  {
+    return;
+  }
+  StepBasic_SourceItem anItemId;
+  theData->ReadEntity(theNum, 1, "item_id", theCheck, anItemId);
+  occ::handle<StepBasic_ExternalSource> aSource;
+  theData->ReadEntity(theNum, 2, "source", theCheck, STANDARD_TYPE(StepBasic_ExternalSource), aSource);
+  occ::handle<NCollection_HArray1<StepBasic_SourceItem>> aReferences;
+  int aSub = 0;
+  if (theData->ReadSubList(theNum, 3, "references", theCheck, aSub))
+  {
+    const int aNb = theData->NbParams(aSub);
+    aReferences   = new NCollection_HArray1<StepBasic_SourceItem>(1, aNb);
+    for (int i = 1; i <= aNb; i++)
+    {
+      StepBasic_SourceItem aReference;
+      theData->ReadEntity(aSub, i, "source_item", theCheck, aReference);
+      aReferences->SetValue(i, aReference);
+    }
+  }
+  theEnt->Init(anItemId, aSource, aReferences);
+}
+
+//=================================================================================================
+
+void RWStepBasic_RWExternallyDefinedItemWithMultipleReferences::WriteStep(
+  StepData_StepWriter&                                                      theSW,
+  const occ::handle<StepBasic_ExternallyDefinedItemWithMultipleReferences>& theEnt) const
+{
+  theSW.Send(theEnt->ItemId().Value());
+  theSW.Send(theEnt->Source());
+  theSW.OpenSub();
+  for (int i = 1; !theEnt->References().IsNull() && i <= theEnt->References()->Length(); i++)
+  {
+    theSW.Send(theEnt->References()->Value(i).Value());
+  }
+  theSW.CloseSub();
+}
+
+//=================================================================================================
+
+void RWStepBasic_RWExternallyDefinedItemWithMultipleReferences::Share(
+  const occ::handle<StepBasic_ExternallyDefinedItemWithMultipleReferences>& theEnt,
+  Interface_EntityIterator&                                                 theIter) const
+{
+  theIter.AddItem(theEnt->Source());
+}
