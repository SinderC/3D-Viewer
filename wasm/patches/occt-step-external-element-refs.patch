+//=================================================================================================
+// Assembly PMI (AP242): component_path_shape_aspect with a next_assembly_usage_occurrence or a
+// multi_level_reference_designator, in one file or across files (CAx-IF External Element
+// References 3.1, section 7; PMI 4.1, section 9.3.4)
+
+// The usages from the root node down to the instance: a NAUO, or the location of a MLRD
+static NCollection_Sequence<occ::handle<StepRepr_NextAssemblyUsageOccurrence>> componentPath(
+  const occ::handle<StepRepr_AssemblyComponentUsage>& theLocation)
+{
+  NCollection_Sequence<occ::handle<StepRepr_NextAssemblyUsageOccurrence>> aPath;
+  if (const occ::handle<StepRepr_NextAssemblyUsageOccurrence> aNAUO =
+        occ::down_cast<StepRepr_NextAssemblyUsageOccurrence>(theLocation))
+  {
+    aPath.Append(aNAUO);
+  }
+  else if (const occ::handle<StepRepr_MultiLevelReferenceDesignator> aMLRD =
+             occ::down_cast<StepRepr_MultiLevelReferenceDesignator>(theLocation))
+  {
+    for (int i = 1; i <= aMLRD->NbLocation(); i++)
+    {
+      aPath.Append(aMLRD->Location()->Value(i));
+    }
+  }
+  return aPath;
+}
+
+// The entity an EXTERNAL_ANCHOR in the header of the model names (ExtRef RP 7.3.1), or null
+static occ::handle<Standard_Transient> findExternalAnchor(
+  const occ::handle<Interface_InterfaceModel>& theModel,
+  const TCollection_AsciiString&               theId)
+{
+  const occ::handle<StepData_StepModel> aModel = occ::down_cast<StepData_StepModel>(theModel);
+  for (Interface_EntityIterator anIter = aModel.IsNull() ? Interface_EntityIterator() : aModel->Header();
+       anIter.More();
+       anIter.Next())
+  {
+    const occ::handle<StepData_UndefinedEntity> anAnchor =
+      occ::down_cast<StepData_UndefinedEntity>(anIter.Value());
+    if (anAnchor.IsNull())
+    {
+      continue;
+    }
+    TCollection_AsciiString aType(anAnchor->StepType());
+    if (!aType.IsEqual("!EXTERNAL_ANCHOR") && !aType.IsEqual("EXTERNAL_ANCHOR"))
+    {
+      continue;
+    }
+    const occ::handle<Interface_UndefinedContent> aContent = anAnchor->UndefinedContent();
+    if (aContent->NbParams() < 2 || aContent->IsParamEntity(1) || !aContent->IsParamEntity(2))
+    {
+      continue;
+    }
+    TCollection_AsciiString anId = aContent->ParamValue(1)->String();
+    if (anId.Length() >= 2 && anId.Value(1) == '\'' && anId.Value(anId.Length()) == '\'')
+    {
+      anId = anId.SubString(2, anId.Length() - 1);
+    }
+    if (anId.IsEqual(theId))
+    {
+      return aContent->ParamEntity(2);
+    }
+  }
+  return nullptr;
+}
+
+// The product definition with the given product, version and definition ids in the model
+static occ::handle<StepBasic_ProductDefinition> findProductDefinition(
+  const occ::handle<Interface_InterfaceModel>& theModel,
+  const occ::handle<TCollection_HAsciiString>& theProductId,
+  const occ::handle<TCollection_HAsciiString>& theFormationId,
+  const occ::handle<TCollection_HAsciiString>& theDefinitionId)
+{
+  const auto isSame = [](const occ::handle<TCollection_HAsciiString>& theA,
+                         const occ::handle<TCollection_HAsciiString>& theB) {
+    return theA.IsNull() || theB.IsNull() ? theA.IsNull() == theB.IsNull() : theA->IsSameString(theB);
+  };
+  for (int i = 1; i <= theModel->NbEntities(); i++)
+  {
+    const occ::handle<StepBasic_ProductDefinition> aPD =
+      occ::down_cast<StepBasic_ProductDefinition>(theModel->Value(i));
+    if (aPD.IsNull() || aPD->Formation().IsNull() || aPD->Formation()->OfProduct().IsNull())
+    {
+      continue;
+    }
+    if (isSame(aPD->Id(), theDefinitionId) && isSame(aPD->Formation()->Id(), theFormationId)
+        && isSame(aPD->Formation()->OfProduct()->Id(), theProductId))
+    {
+      return aPD;
+    }
+  }
+  return nullptr;
+}
+
+// The usage in theGraph of a component in theParent with the given reference designator
+static occ::handle<StepRepr_NextAssemblyUsageOccurrence> findUsage(
+  const Interface_Graph&                          theGraph,
+  const occ::handle<StepBasic_ProductDefinition>& theParent,
+  const occ::handle<TCollection_HAsciiString>&    theReferenceDesignator)
+{
+  for (Interface_EntityIterator anIter = theGraph.Sharings(theParent); anIter.More(); anIter.Next())
+  {
+    const occ::handle<StepRepr_NextAssemblyUsageOccurrence> aNAUO =
+      occ::down_cast<StepRepr_NextAssemblyUsageOccurrence>(anIter.Value());
+    if (!aNAUO.IsNull() && aNAUO->RelatingProductDefinitionAP242().Value() == theParent
+        && aNAUO->HasReferenceDesignator() && !theReferenceDesignator.IsNull()
+        && aNAUO->ReferenceDesignator()->IsSameString(theReferenceDesignator))
+    {
+      return aNAUO;
+    }
+  }
+  return nullptr;
+}
+
+//=================================================================================================
+
+occ::handle<STEPCAFControl_ExternFile> STEPCAFControl_Reader::externFileOf(
+  const occ::handle<Standard_Transient>&    theDefinition,
+  const occ::handle<XSControl_WorkSession>& theWS) const
+{
+  // A local representation of a part in another file: the file of its external reference
+  occ::handle<STEPCAFControl_ExternFile> aFile;
+  if (myPDFiles.Find(theDefinition, aFile))
+  {
+    return aFile;
+  }
+  // A product definition reference: its source names the file (ExtRef RP 7.4.1, Table 3), or is
+  // the location of a file reference whose assigned id is the name (5.2.3)
+  occ::handle<StepBasic_ExternalSource> aSource;
+  if (const occ::handle<StepBasic_ProductDefinitionReference> aPDR =
+        occ::down_cast<StepBasic_ProductDefinitionReference>(theDefinition))
+  {
+    aSource = aPDR->Source();
+  }
+  else if (const occ::handle<StepBasic_ProductDefinitionReferenceWithLocalRepresentation> aPDRLR =
+             occ::down_cast<StepBasic_ProductDefinitionReferenceWithLocalRepresentation>(theDefinition))
+  {
+    aSource = aPDRLR->Source();
+  }
+  if (aSource.IsNull())
+  {
+    return nullptr;
+  }
+  NCollection_Sequence<TCollection_AsciiString> aNames;
+  if (const occ::handle<StepData_SelectNamed> anId =
+        occ::down_cast<StepData_SelectNamed>(aSource->SourceId().Value());
+      !anId.IsNull() && anId->Kind() == 6 && anId->String() != nullptr)
+  {
+    aNames.Append(anId->String());
+  }
+  for (Interface_EntityIterator anIter = theWS->Graph().Sharings(aSource); anIter.More(); anIter.Next())
+  {
+    const occ::handle<StepAP214_AppliedExternalIdentificationAssignment> anAEIA =
+      occ::down_cast<StepAP214_AppliedExternalIdentificationAssignment>(anIter.Value());
+    if (!anAEIA.IsNull() && !anAEIA->AssignedId().IsNull())
+    {
+      aNames.Append(anAEIA->AssignedId()->String());
+    }
+  }
+  for (TCollection_AsciiString aName : aNames)
+  {
+    OSD_Path aPath(aName);
+    aName = aPath.Name() + aPath.Extension();
+    for (NCollection_DataMap<TCollection_AsciiString, occ::handle<STEPCAFControl_ExternFile>>::Iterator
+           anIter(myFiles);
+         anIter.More();
+         anIter.Next())
+    {
+      OSD_Path aFilePath(anIter.Key());
+      if (TCollection_AsciiString::IsSameString(aName, aFilePath.Name() + aFilePath.Extension(), false))
+      {
+        return anIter.Value();
+      }
+    }
+  }
+  return nullptr;
+}
+
+//=================================================================================================
+
+bool STEPCAFControl_Reader::readInstancePath(
+  const occ::handle<StepRepr_AssemblyComponentUsage>& theLocation,
+  const occ::handle<XSControl_WorkSession>&           theWS,
+  const occ::handle<XCAFDoc_ShapeTool>&               theSTool,
+  NCollection_Sequence<TDF_Label>&                    thePath,
+  occ::handle<XSControl_WorkSession>&                 theLeafWS) const
+{
+  thePath.Clear();
+  theLeafWS                                                                     = theWS;
+  const NCollection_Sequence<occ::handle<StepRepr_NextAssemblyUsageOccurrence>> aPath =
+    componentPath(theLocation);
+  if (aPath.IsEmpty())
+  {
+    return false;
+  }
+  // A component label per level. A usage whose parent is a part in another file is a reference to
+  // the usage there with the same reference designator (ExtRef RP 7.4.1).
+  for (const occ::handle<StepRepr_NextAssemblyUsageOccurrence>& aNAUO : aPath)
+  {
+    if (aNAUO.IsNull())
+    {
+      return false;
+    }
+    occ::handle<StepRepr_NextAssemblyUsageOccurrence> anUsage   = aNAUO;
+    occ::handle<XSControl_WorkSession>                anUsageWS = theWS;
+    const occ::handle<Standard_Transient> aParent = aNAUO->RelatingProductDefinitionAP242().Value();
+    if (const occ::handle<STEPCAFControl_ExternFile> aFile = externFileOf(aParent, theWS))
+    {
+      if (aFile->GetWS().IsNull())
+      {
+        return false;
+      }
+      anUsageWS = aFile->GetWS();
+      occ::handle<StepBasic_ProductDefinition> aDefinition;
+      if (const occ::handle<StepBasic_ProductDefinitionReference> aPDR =
+            occ::down_cast<StepBasic_ProductDefinitionReference>(aParent))
+      {
+        aDefinition = findProductDefinition(anUsageWS->Model(),
+                                            aPDR->ProductId(),
+                                            aPDR->ProductDefinitionFormationId(),
+                                            aPDR->ProductDefinitionId());
+      }
+      else if (const occ::handle<StepBasic_ProductDefinition> aLocal =
+                 occ::down_cast<StepBasic_ProductDefinition>(aParent);
+               !aLocal.IsNull() && !aLocal->Formation().IsNull()
+               && !aLocal->Formation()->OfProduct().IsNull())
+      {
+        aDefinition = findProductDefinition(anUsageWS->Model(),
+                                            aLocal->Formation()->OfProduct()->Id(),
+                                            aLocal->Formation()->Id(),
+                                            aLocal->Id());
+      }
+      anUsage = aDefinition.IsNull()
+                  ? nullptr
+                  : findUsage(anUsageWS->Graph(), aDefinition, aNAUO->ReferenceDesignator());
+      if (anUsage.IsNull())
+      {
+        return false;
+      }
+    }
+    const TDF_Label aComponent =
+      FindInstance(anUsage, theSTool, STEPConstruct_Tool(anUsageWS), myMap);
+    if (aComponent.IsNull())
+    {
+      return false;
+    }
+    thePath.Append(aComponent);
+    theLeafWS = anUsageWS;
+  }
+  return true;
+}
+
+//=================================================================================================
+
+bool STEPCAFControl_Reader::readAssemblyReference(
+  const occ::handle<StepRepr_ComponentPathShapeAspect>& theCPSA,
+  const occ::handle<XSControl_WorkSession>&             theWS,
+  const occ::handle<XCAFDoc_ShapeTool>&                 theSTool,
+  AssemblyShapeReference&                               theRef) const
+{
+  occ::handle<XSControl_WorkSession> aLeafWS;
+  if (!readInstancePath(theCPSA->Location(), theWS, theSTool, theRef.Path, aLeafWS))
+  {
+    return false;
+  }
+  const NCollection_Sequence<occ::handle<StepRepr_NextAssemblyUsageOccurrence>> aPath =
+    componentPath(theCPSA->Location());
+  theRef.Assembly = theRef.Path.First().Father();
+
+  // The shapes: the component's shape aspect, here or (an external anchor) in the leaf's file
+  occ::handle<StepRepr_ShapeAspect> aShapeAspect = theCPSA->ComponentShapeAspect();
+  if (aShapeAspect.IsNull() && !theCPSA->ComponentShapeAspectId().IsNull())
+  {
+    const occ::handle<Standard_Transient> aLeaf = aPath.Last()->RelatedProductDefinitionAP242().Value();
+    if (const occ::handle<STEPCAFControl_ExternFile> aFile = externFileOf(aLeaf, theWS))
+    {
+      aLeafWS = aFile->GetWS();
+    }
+    aShapeAspect = aLeafWS.IsNull()
+                     ? nullptr
+                     : occ::down_cast<StepRepr_ShapeAspect>(findExternalAnchor(
+                         aLeafWS->Model(),
+                         theCPSA->ComponentShapeAspectId()->String()));
+  }
+  else
+  {
+    aLeafWS = theWS;
+  }
+  if (aShapeAspect.IsNull())
+  {
+    return false;
+  }
+  NCollection_Sequence<occ::handle<StepRepr_ShapeAspect>> aSAs;
+  collectShapeAspect(aShapeAspect, aLeafWS, aSAs);
+  for (const occ::handle<StepRepr_ShapeAspect>& aSA : aSAs)
+  {
+    for (Interface_EntityIterator anIter = aLeafWS->Graph().Sharings(aSA); anIter.More(); anIter.Next())
+    {
+      const occ::handle<StepAP242_ItemIdentifiedRepresentationUsage> anUsage =
+        geometryUsage(anIter.Value());
+      for (int i = 1; !anUsage.IsNull() && i <= anUsage->NbIdentifiedItem(); i++)
+      {
+        const TDF_Label aShape = getShapeLabel(anUsage->IdentifiedItemValue(i), aLeafWS, theSTool);
+        if (!aShape.IsNull())
+        {
+          appendUnique(theRef.Shapes, aShape);
+        }
+      }
+    }
+  }
+  return true;
+}
+
+//=================================================================================================
+
+NCollection_Sequence<STEPCAFControl_Reader::AssemblyShapeReference> STEPCAFControl_Reader::
+  readAssemblyReferences(const occ::handle<Standard_Transient>&    theEnt,
+                         const occ::handle<XSControl_WorkSession>& theWS,
+                         const occ::handle<XCAFDoc_ShapeTool>&     theSTool) const
+{
+  NCollection_Sequence<AssemblyShapeReference> aRefs;
+  const Interface_Graph&                       aGraph = theWS->Graph();
+  // The shape aspects the entity refers to, as createGDTObjectInXCAF finds them; for a dimensional
+  // location, which side each is on
+  NCollection_Sequence<occ::handle<StepRepr_ShapeAspect>> aStarts;
+  NCollection_Sequence<bool>                              aSides;
+  const auto addStarts = [&](const occ::handle<Standard_Transient>& theOf) {
+    const occ::handle<StepShape_DimensionalLocation> aLocation =
+      occ::down_cast<StepShape_DimensionalLocation>(theOf);
+    for (Interface_EntityIterator anIter = aGraph.Shareds(theOf); anIter.More(); anIter.Next())
+    {
+      if (const occ::handle<StepRepr_ShapeAspect> aSA =
+            occ::down_cast<StepRepr_ShapeAspect>(anIter.Value()))
+      {
+        aStarts.Append(aSA);
+        aSides.Append(!aLocation.IsNull() && aLocation->RelatedShapeAspect() == aSA);
+      }
+    }
+  };
+  if (const occ::handle<StepRepr_ShapeAspect> aSA = occ::down_cast<StepRepr_ShapeAspect>(theEnt))
+  {
+    aStarts.Append(aSA);
+    aSides.Append(false);
+  }
+  else
+  {
+    addStarts(theEnt);
+    // a tolerance applied to a dimension
+    for (Interface_EntityIterator anIter = aGraph.Shareds(theEnt); anIter.More(); anIter.Next())
+    {
+      if (anIter.Value()->IsKind(STANDARD_TYPE(StepShape_DimensionalLocation))
+          || anIter.Value()->IsKind(STANDARD_TYPE(StepShape_DimensionalSize)))
+      {
+        addStarts(anIter.Value());
+      }
+    }
+  }
+
+  NCollection_Map<occ::handle<Standard_Transient>> aDone;
+  for (int i = 1; i <= aStarts.Length(); i++)
+  {
+    NCollection_Sequence<occ::handle<StepRepr_ShapeAspect>>              aSAs;
+    NCollection_Sequence<occ::handle<StepRepr_ComponentPathShapeAspect>> aContexts;
+    collectShapeAspect(aStarts(i), theWS, aSAs, &aContexts, nullptr);
+    for (const occ::handle<StepRepr_ComponentPathShapeAspect>& aCPSA : aContexts)
+    {
+      if (aCPSA.IsNull() || !aDone.Add(aCPSA))
+      {
+        continue;
+      }
+      AssemblyShapeReference aRef;
+      aRef.IsSecond = aSides(i);
+      if (readAssemblyReference(aCPSA, theWS, theSTool, aRef))
+      {
+        aRefs.Append(aRef);
+      }
+    }
+  }
+  return aRefs;
+}
