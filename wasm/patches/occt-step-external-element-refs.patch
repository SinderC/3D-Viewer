+
+#include "RWStepRepr_RWExternallyDefinedRepresentation.pxx"
+#include <Interface_EntityIterator.hxx>
+#include <StepData_StepReaderData.hxx>
+#include <StepData_StepWriter.hxx>
+#include <StepRepr_ExternallyDefinedRepresentation.hxx>
+#include <StepRepr_RepresentationContext.hxx>
+#include <StepRepr_RepresentationItem.hxx>
+#include <TCollection_HAsciiString.hxx>
+
+//=================================================================================================
+
+RWStepRepr_RWExternallyDefinedRepresentation::RWStepRepr_RWExternallyDefinedRepresentation() =
+  default;
+
+//=================================================================================================
+
+void RWStepRepr_RWExternallyDefinedRepresentation::ReadStep(
+  const occ::handle<StepData_StepReaderData>&                  theData,
+  const int                                                    theNum,
+  occ::handle<Interface_Check>&                                theCheck,
+  const occ::handle<StepRepr_ExternallyDefinedRepresentation>& theEnt) const
+{
+  // representation (name, items, context_of_items), then externally_defined_item (item_id,
+  // source); files written by OCCT before have the first three only
+  if (theData->NbParams(theNum) != 3
+      && !theData->CheckNbParams(theNum, 5, theCheck, "externally_defined_representation"))
+  {
+    return;
+  }
+  occ::handle<TCollection_HAsciiString> aName;
+  theData->ReadString(theNum, 1, "representation.name", theCheck, aName);
+  occ::handle<NCollection_HArray1<occ::handle<StepRepr_RepresentationItem>>> anItems;
+  int aSub = 0;
+  if (theData->ReadSubList(theNum, 2, "representation.items", theCheck, aSub))
+  {
+    const int aNb = theData->NbParams(aSub);
+    anItems       = new NCollection_HArray1<occ::handle<StepRepr_RepresentationItem>>(1, aNb);
+    for (int i = 1; i <= aNb; i++)
+    {
+      occ::handle<StepRepr_RepresentationItem> anItem;
+      theData->ReadEntity(aSub,
+                          i,
+                          "representation_item",
+                          theCheck,
+                          STANDARD_TYPE(StepRepr_RepresentationItem),
+                          anItem);
+      anItems->SetValue(i, anItem);
+    }
+  }
+  occ::handle<StepRepr_RepresentationContext> aContext;
+  theData->ReadEntity(theNum,
+                      3,
+                      "representation.context_of_items",
+                      theCheck,
+                      STANDARD_TYPE(StepRepr_RepresentationContext),
+                      aContext);
+  StepBasic_SourceItem                  anItemId;
+  occ::handle<StepBasic_ExternalSource> aSource;
+  if (theData->NbParams(theNum) == 5)
+  {
+    theData->ReadEntity(theNum, 4, "externally_defined_item.item_id", theCheck, anItemId);
+    theData->ReadEntity(theNum,
+                        5,
+                        "externally_defined_item.source",
+                        theCheck,
+                        STANDARD_TYPE(StepBasic_ExternalSource),
+                        aSource);
+  }
+  theEnt->Init(aName, anItems, aContext);
+  theEnt->SetItemId(anItemId);
+  theEnt->SetSource(aSource);
+}
+
+//=================================================================================================
+
+void RWStepRepr_RWExternallyDefinedRepresentation::WriteStep(
+  StepData_StepWriter&                                         theSW,
+  const occ::handle<StepRepr_ExternallyDefinedRepresentation>& theEnt) const
+{
+  theSW.Send(theEnt->Name());
+  theSW.OpenSub();
+  for (int i = 1; i <= theEnt->NbItems(); i++)
+  {
+    theSW.Send(theEnt->ItemsValue(i));
+  }
+  theSW.CloseSub();
+  theSW.Send(theEnt->ContextOfItems());
+  theSW.Send(theEnt->ItemId().Value());
+  theSW.Send(theEnt->Source());
+}
+
+//=================================================================================================
+
+void RWStepRepr_RWExternallyDefinedRepresentation::Share(
+  const occ::handle<StepRepr_ExternallyDefinedRepresentation>& theEnt,
+  Interface_EntityIterator&                                    theIter) const
+{
+  for (int i = 1; i <= theEnt->NbItems(); i++)
+  {
+    theIter.AddItem(theEnt->ItemsValue(i));
+  }
+  theIter.AddItem(theEnt->ContextOfItems());
+  theIter.AddItem(theEnt->Source());
+}
