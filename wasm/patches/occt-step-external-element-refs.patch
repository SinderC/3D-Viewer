+// distribution for complete text of the license and disclaimer of any warranty.
+//
+// Alternatively, this file may be used under the terms of Open CASCADE
+// commercial license or contractual agreement.
+
+#ifndef _StepRepr_MultiLevelReferenceDesignator_HeaderFile
+#define _StepRepr_MultiLevelReferenceDesignator_HeaderFile
+
+#include <Standard.hxx>
+#include <Standard_Type.hxx>
+
+#include <NCollection_HArray1.hxx>
+#include <StepRepr_AssemblyComponentUsage.hxx>
+#include <StepRepr_NextAssemblyUsageOccurrence.hxx>
+
+//! Representation of STEP entity Multi_Level_Reference_Designator (AP242): a component instance
+//! deep in an assembly, given as the top-down list of next_assembly_usage_occurrences from the
+//! root node to the leaf node. The relating and related product definitions are derived from the
+//! location (written as '*'); they are not set by the reader.
+class StepRepr_MultiLevelReferenceDesignator : public StepRepr_AssemblyComponentUsage
+{
+public:
+  //! Empty constructor
+  Standard_EXPORT StepRepr_MultiLevelReferenceDesignator();
+
+  //! Initialize all fields; the relating and related product definitions stay empty
+  Standard_EXPORT void Init(
+    const occ::handle<TCollection_HAsciiString>& theId,
+    const occ::handle<TCollection_HAsciiString>& theName,
+    const bool                                   theHasDescription,
+    const occ::handle<TCollection_HAsciiString>& theDescription,
+    const bool                                   theHasReferenceDesignator,
+    const occ::handle<TCollection_HAsciiString>& theReferenceDesignator,
+    const occ::handle<NCollection_HArray1<occ::handle<StepRepr_NextAssemblyUsageOccurrence>>>&
+      theLocation);
+
+  //! Returns field Location: the usages from the root node down to the leaf node
+  const occ::handle<NCollection_HArray1<occ::handle<StepRepr_NextAssemblyUsageOccurrence>>>&
+    Location() const
+  {
+    return myLocation;
+  }
+
+  //! Set field Location
+  void SetLocation(
+    const occ::handle<NCollection_HArray1<occ::handle<StepRepr_NextAssemblyUsageOccurrence>>>&
+      theLocation)
+  {
+    myLocation = theLocation;
+  }
+
+  //! Returns the number of usages in Location
+  int NbLocation() const { return myLocation.IsNull() ? 0 : myLocation->Length(); }
+
+  //! Returns the root node: the relating product definition of the first usage (derived)
+  Standard_EXPORT StepBasic_ProductDefinitionOrReference Root() const;
+
+  //! Returns the leaf node: the related product definition of the last usage (derived)
+  Standard_EXPORT StepBasic_ProductDefinitionOrReference Leaf() const;
+
+  DEFINE_STANDARD_RTTIEXT(StepRepr_MultiLevelReferenceDesignator, StepRepr_AssemblyComponentUsage)
+
+private:
+  occ::handle<NCollection_HArray1<occ::handle<StepRepr_NextAssemblyUsageOccurrence>>> myLocation;
+};
+
+#endif // _StepRepr_MultiLevelReferenceDesignator_HeaderFile
