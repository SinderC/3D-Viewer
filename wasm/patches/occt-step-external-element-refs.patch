+
+#include "RWStepRepr_RWComponentPathShapeAspect.pxx"
+#include <Interface_EntityIterator.hxx>
+#include <StepData_SelectNamed.hxx>
+#include <StepData_StepReaderData.hxx>
+#include <StepData_StepWriter.hxx>
+#include <StepRepr_ComponentPathShapeAspect.hxx>
+#include <StepRepr_ProductDefinitionShape.hxx>
+#include <TCollection_HAsciiString.hxx>
+
+//=================================================================================================
+
+RWStepRepr_RWComponentPathShapeAspect::RWStepRepr_RWComponentPathShapeAspect() = default;
+
+//=================================================================================================
+
+void RWStepRepr_RWComponentPathShapeAspect::ReadStep(
+  const occ::handle<StepData_StepReaderData>&           theData,
+  const int                                             theNum,
+  occ::handle<Interface_Check>&                         theCheck,
+  const occ::handle<StepRepr_ComponentPathShapeAspect>& theEnt) const
+{
+  if (!theData->CheckNbParams(theNum, 6, theCheck, "component_path_shape_aspect"))
+  {
+    return;
+  }
+
+  occ::handle<TCollection_HAsciiString> aName, aDescription;
+  theData->ReadString(theNum, 1, "shape_aspect.name", theCheck, aName);
+  if (theData->IsParamDefined(theNum, 2))
+  {
+    theData->ReadString(theNum, 2, "shape_aspect.description", theCheck, aDescription);
+  }
+  occ::handle<StepRepr_ProductDefinitionShape> anOfShape;
+  theData->ReadEntity(theNum,
+                      3,
+                      "shape_aspect.of_shape",
+                      theCheck,
+                      STANDARD_TYPE(StepRepr_ProductDefinitionShape),
+                      anOfShape);
+  StepData_Logical aProductDefinitional = StepData_LUnknown;
+  theData->ReadLogical(theNum, 4, "shape_aspect.product_definitional", theCheck, aProductDefinitional);
+
+  occ::handle<StepRepr_AssemblyComponentUsage> aLocation;
+  theData->ReadEntity(theNum,
+                      5,
+                      "location",
+                      theCheck,
+                      STANDARD_TYPE(StepRepr_AssemblyComponentUsage),
+                      aLocation);
+
+  // internal_or_reflected_shape_aspect: a shape_aspect, or an identifier (typed or not)
+  occ::handle<StepRepr_ShapeAspect>     aComponentShapeAspect;
+  occ::handle<TCollection_HAsciiString> aComponentShapeAspectId;
+  if (theData->ParamType(theNum, 6) == Interface_ParamIdent)
+  {
+    theData->ReadEntity(theNum,
+                        6,
+                        "component_shape_aspect",
+                        theCheck,
+                        STANDARD_TYPE(StepRepr_ShapeAspect),
+                        aComponentShapeAspect);
+  }
+  else
+  {
+    occ::handle<StepData_SelectNamed> anId = new StepData_SelectNamed;
+    if (theData->ReadMember(theNum, 6, "component_shape_aspect", theCheck, anId) && anId->Kind() == 6)
+    {
+      aComponentShapeAspectId = new TCollection_HAsciiString(anId->String());
+    }
+  }
+
+  theEnt->Init(aName,
+               aDescription,
+               anOfShape,
+               aProductDefinitional,
+               aLocation,
+               aComponentShapeAspect,
+               aComponentShapeAspectId);
+}
+
+//=================================================================================================
+
+void RWStepRepr_RWComponentPathShapeAspect::WriteStep(
+  StepData_StepWriter&                                  theSW,
+  const occ::handle<StepRepr_ComponentPathShapeAspect>& theEnt) const
+{
+  theSW.Send(theEnt->Name());
+  if (!theEnt->Description().IsNull())
+  {
+    theSW.Send(theEnt->Description());
+  }
+  else
+  {
+    theSW.SendUndef();
+  }
+  theSW.Send(theEnt->OfShape());
+  theSW.SendLogical(theEnt->ProductDefinitional());
+  theSW.Send(theEnt->Location());
+  if (!theEnt->ComponentShapeAspect().IsNull())
+  {
+    theSW.Send(theEnt->ComponentShapeAspect());
+  }
+  else
+  {
+    theSW.OpenTypedSub("IDENTIFIER");
+    theSW.Send(theEnt->ComponentShapeAspectId());
+    theSW.CloseSub();
+  }
+}
+
+//=================================================================================================
+
+void RWStepRepr_RWComponentPathShapeAspect::Share(
+  const occ::handle<StepRepr_ComponentPathShapeAspect>& theEnt,
+  Interface_EntityIterator&                             theIter) const
+{
+  theIter.AddItem(theEnt->OfShape());
+  theIter.AddItem(theEnt->Location());
+  theIter.AddItem(theEnt->ComponentShapeAspect());
+}
