+IMPLEMENT_STANDARD_RTTIEXT(StepRepr_MultiLevelReferenceDesignator, StepRepr_AssemblyComponentUsage)
+
+//=================================================================================================
+
+StepRepr_MultiLevelReferenceDesignator::StepRepr_MultiLevelReferenceDesignator() = default;
+
+//=================================================================================================
+
+void StepRepr_MultiLevelReferenceDesignator::Init(
+  const occ::handle<TCollection_HAsciiString>& theId,
+  const occ::handle<TCollection_HAsciiString>& theName,
+  const bool                                   theHasDescription,
+  const occ::handle<TCollection_HAsciiString>& theDescription,
+  const bool                                   theHasReferenceDesignator,
+  const occ::handle<TCollection_HAsciiString>& theReferenceDesignator,
+  const occ::handle<NCollection_HArray1<occ::handle<StepRepr_NextAssemblyUsageOccurrence>>>&
+    theLocation)
+{
+  StepRepr_AssemblyComponentUsage::Init(theId,
+                                        theName,
+                                        theHasDescription,
+                                        theDescription,
+                                        StepBasic_ProductDefinitionOrReference(),
+                                        StepBasic_ProductDefinitionOrReference(),
+                                        theHasReferenceDesignator,
+                                        theReferenceDesignator);
+  myLocation = theLocation;
+}
+
+//=================================================================================================
+
+StepBasic_ProductDefinitionOrReference StepRepr_MultiLevelReferenceDesignator::Root() const
+{
+  if (NbLocation() == 0 || myLocation->First().IsNull())
+  {
+    return StepBasic_ProductDefinitionOrReference();
+  }
+  return myLocation->First()->RelatingProductDefinitionAP242();
+}
+
+//=================================================================================================
+
+StepBasic_ProductDefinitionOrReference StepRepr_MultiLevelReferenceDesignator::Leaf() const
+{
+  if (NbLocation() == 0 || myLocation->Last().IsNull())
+  {
+    return StepBasic_ProductDefinitionOrReference();
+  }
+  return myLocation->Last()->RelatedProductDefinitionAP242();
+}
