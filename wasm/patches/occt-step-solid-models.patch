 bool NM_DETECTED = false;
+
+// CSG and swept solids (ISO 10303-42 csg_solid, boolean_result, the CSG primitives, half-spaces,
+// extruded and revolved areas and faces, solid replicas), which OCCT read but did not convert.
+// AP203 and AP214 allow them; AP203 e2 has them as conformance options co20 and co72.
+class SolidModelBuilder
+{
+public:
+  SolidModelBuilder(const occ::handle<Transfer_TransientProcess>& theTP,
+                    const StepData_Factors&                       theFactors,
+                    const double                                  thePrecision,
+                    const double                                  theMaxTol)
+      : myTP(theTP),
+        myFactors(theFactors),
+        myPrecision(thePrecision),
+        myMaxTol(theMaxTol)
+  {
+  }
+
+  static bool IsSupported(const occ::handle<Standard_Transient>& theItem)
+  {
+    return theItem->IsKind(STANDARD_TYPE(StepShape_CsgSolid))
+           || theItem->IsKind(STANDARD_TYPE(StepShape_BooleanResult))
+           || theItem->IsKind(STANDARD_TYPE(StepShape_Block))
+           || theItem->IsKind(STANDARD_TYPE(StepShape_RightAngularWedge))
+           || theItem->IsKind(STANDARD_TYPE(StepShape_RightCircularCone))
+           || theItem->IsKind(STANDARD_TYPE(StepShape_RightCircularCylinder))
+           || theItem->IsKind(STANDARD_TYPE(StepShape_Sphere))
+           || theItem->IsKind(STANDARD_TYPE(StepShape_Torus))
+           || theItem->IsKind(STANDARD_TYPE(StepShape_BoxedHalfSpace))
+           || theItem->IsKind(STANDARD_TYPE(StepShape_ExtrudedAreaSolid))
+           || theItem->IsKind(STANDARD_TYPE(StepShape_RevolvedAreaSolid))
+           || theItem->IsKind(STANDARD_TYPE(StepShape_ExtrudedFaceSolid))
+           || theItem->IsKind(STANDARD_TYPE(StepShape_RevolvedFaceSolid))
+           || theItem->IsKind(STANDARD_TYPE(StepShape_SolidReplica));
+  }
+
+  //! The solid; null if it cannot be made. theRegion bounds an unboxed half-space: it is
+  //! infinite, and is made as a box that covers the region on the material side.
+  TopoDS_Shape Build(const occ::handle<Standard_Transient>& theItem,
+                     const Bnd_Box&                         theRegion = Bnd_Box()) const
+  {
+    if (theItem.IsNull())
+    {
+      return TopoDS_Shape();
+    }
+    if (const auto aCsg = occ::down_cast<StepShape_CsgSolid>(theItem); !aCsg.IsNull())
+    {
+      const StepShape_CsgSelect& aRoot = aCsg->TreeRootExpression();
+      return Build(aRoot.BooleanResult().IsNull()
+                     ? occ::handle<Standard_Transient>(aRoot.CsgPrimitive().Value())
+                     : occ::handle<Standard_Transient>(aRoot.BooleanResult()),
+                   theRegion);
+    }
+    if (const auto aBool = occ::down_cast<StepShape_BooleanResult>(theItem); !aBool.IsNull())
+    {
+      return boolean(aBool, theRegion);
+    }
+    if (const auto aHalf = occ::down_cast<StepShape_HalfSpaceSolid>(theItem); !aHalf.IsNull())
+    {
+      return halfSpace(aHalf, theRegion);
+    }
+    if (const auto aBlock = occ::down_cast<StepShape_Block>(theItem); !aBlock.IsNull())
+    {
+      return BRepPrimAPI_MakeBox(ax2(aBlock->Position()),
+                                 length(aBlock->X()),
+                                 length(aBlock->Y()),
+                                 length(aBlock->Z()))
+        .Shape();
+    }
+    if (const auto aWedge = occ::down_cast<StepShape_RightAngularWedge>(theItem); !aWedge.IsNull())
+    {
+      return BRepPrimAPI_MakeWedge(ax2(aWedge->Position()),
+                                   length(aWedge->X()),
+                                   length(aWedge->Y()),
+                                   length(aWedge->Z()),
+                                   length(aWedge->Ltx()))
+        .Shape();
+    }
+    if (const auto aCyl = occ::down_cast<StepShape_RightCircularCylinder>(theItem); !aCyl.IsNull())
+    {
+      const gp_Ax1 anAxis = ax1(aCyl->Position());
+      return BRepPrimAPI_MakeCylinder(gp_Ax2(anAxis.Location(), anAxis.Direction()),
+                                      length(aCyl->Radius()),
+                                      length(aCyl->Height()))
+        .Shape();
+    }
+    if (const auto aCone = occ::down_cast<StepShape_RightCircularCone>(theItem); !aCone.IsNull())
+    {
+      // The placement is at the face of the given radius (the apex if it is zero), its axis
+      // pointing out of the solid: the cone widens the other way.
+      const gp_Ax1 anAxis = ax1(aCone->Position());
+      const double aHeight = length(aCone->Height()), aRadius = length(aCone->Radius());
+      const double aBase   = aRadius + aHeight * std::tan(angle(aCone->SemiAngle()));
+      const gp_Pnt aBaseCentre = anAxis.Location().Translated(-aHeight * gp_Vec(anAxis.Direction()));
+      return BRepPrimAPI_MakeCone(gp_Ax2(aBaseCentre, anAxis.Direction()), aBase, aRadius, aHeight)
+        .Shape();
+    }
+    if (const auto aSphere = occ::down_cast<StepShape_Sphere>(theItem); !aSphere.IsNull())
+    {
+      const auto aCentre = StepToGeom::MakeCartesianPoint(
+        occ::down_cast<StepGeom_CartesianPoint>(aSphere->Centre()), myFactors);
+      return aCentre.IsNull()
+               ? TopoDS_Shape()
+               : BRepPrimAPI_MakeSphere(aCentre->Pnt(), length(aSphere->Radius())).Shape();
+    }
+    if (const auto aTorus = occ::down_cast<StepShape_Torus>(theItem); !aTorus.IsNull())
+    {
+      const gp_Ax1 anAxis = ax1(aTorus->Position());
+      return BRepPrimAPI_MakeTorus(gp_Ax2(anAxis.Location(), anAxis.Direction()),
+                                   length(aTorus->MajorRadius()),
+                                   length(aTorus->MinorRadius()))
+        .Shape();
+    }
+    if (const auto anArea = occ::down_cast<StepShape_ExtrudedAreaSolid>(theItem); !anArea.IsNull())
+    {
+      return extrude(area(anArea->SweptArea()), anArea->ExtrudedDirection(), anArea->Depth());
+    }
+    if (const auto anArea = occ::down_cast<StepShape_RevolvedAreaSolid>(theItem); !anArea.IsNull())
+    {
+      return revolve(area(anArea->SweptArea()), anArea->Axis(), anArea->Angle());
+    }
+    if (const auto aFace = occ::down_cast<StepShape_ExtrudedFaceSolid>(theItem); !aFace.IsNull())
+    {
+      return extrude(face(aFace->SweptFace()), aFace->ExtrudedDirection(), aFace->Depth());
+    }
+    if (const auto aFace = occ::down_cast<StepShape_RevolvedFaceSolid>(theItem); !aFace.IsNull())
+    {
+      return revolve(face(aFace->SweptFace()), aFace->Axis(), aFace->Angle());
+    }
+    if (const auto aReplica = occ::down_cast<StepShape_SolidReplica>(theItem); !aReplica.IsNull())
+    {
+      const TopoDS_Shape aParent = Build(aReplica->ParentSolid(), theRegion);
+      gp_Trsf            aTrsf;
+      if (aParent.IsNull()
+          || !StepToGeom::MakeTransformation3d(aReplica->Transformation(), aTrsf, myFactors))
+      {
+        return TopoDS_Shape();
+      }
+      return BRepBuilderAPI_Transform(aParent, aTrsf, true).Shape();
+    }
+    return TopoDS_Shape();
+  }
+
+private:
+  double length(const double theValue) const { return theValue * myFactors.LengthFactor(); }
+
+  double angle(const double theValue) const { return theValue * myFactors.PlaneAngleFactor(); }
+
+  gp_Ax2 ax2(const occ::handle<StepGeom_Axis2Placement3d>& thePlacement) const
+  {
+    const auto anAx = StepToGeom::MakeAxis2Placement(thePlacement, myFactors);
+    return anAx.IsNull() ? gp_Ax2() : anAx->Ax2();
+  }
+
+  gp_Ax1 ax1(const occ::handle<StepGeom_Axis1Placement>& thePlacement) const
+  {
+    const auto anAx = StepToGeom::MakeAxis1Placement(thePlacement, myFactors);
+    return anAx.IsNull() ? gp_Ax1() : anAx->Ax1();
+  }
+
+  static occ::handle<Standard_Transient> operand(const StepShape_BooleanOperand& theOperand)
+  {
+    if (!theOperand.SolidModel().IsNull())
+    {
+      return theOperand.SolidModel();
+    }
+    if (!theOperand.HalfSpaceSolid().IsNull())
+    {
+      return theOperand.HalfSpaceSolid();
+    }
+    if (!theOperand.BooleanResult().IsNull())
+    {
+      return theOperand.BooleanResult();
+    }
+    return theOperand.CsgPrimitive().Value();
+  }
+
+  // Operands other than half-spaces first: a half-space is made to cover the others.
+  TopoDS_Shape boolean(const occ::handle<StepShape_BooleanResult>& theBool,
+                       const Bnd_Box&                              theRegion) const
+  {
+    const occ::handle<Standard_Transient> anItems[2] = {operand(theBool->FirstOperand()),
+                                                        operand(theBool->SecondOperand())};
+    TopoDS_Shape                          aShapes[2];
+    Bnd_Box                               aRegion = theRegion;
+    for (int i = 0; i < 2; ++i)
+    {
+      if (!anItems[i].IsNull() && !anItems[i]->IsKind(STANDARD_TYPE(StepShape_HalfSpaceSolid)))
+      {
+        aShapes[i] = Build(anItems[i], theRegion);
+        if (aShapes[i].IsNull())
+        {
+          return TopoDS_Shape();
+        }
+        BRepBndLib::Add(aShapes[i], aRegion);
+      }
+    }
+    for (int i = 0; i < 2; ++i)
+    {
+      if (aShapes[i].IsNull())
+      {
+        aShapes[i] = Build(anItems[i], aRegion);
+        if (aShapes[i].IsNull())
+        {
+          return TopoDS_Shape();
+        }
+      }
+    }
+    switch (theBool->Operator())
+    {
+      case StepShape_boDifference: {
+        BRepAlgoAPI_Cut anOp(aShapes[0], aShapes[1]);
+        return anOp.IsDone() ? anOp.Shape() : TopoDS_Shape();
+      }
+      case StepShape_boIntersection: {
+        BRepAlgoAPI_Common anOp(aShapes[0], aShapes[1]);
+        return anOp.IsDone() ? anOp.Shape() : TopoDS_Shape();
+      }
+      case StepShape_boUnion: {
+        BRepAlgoAPI_Fuse anOp(aShapes[0], aShapes[1]);
+        return anOp.IsDone() ? anOp.Shape() : TopoDS_Shape();
+      }
+    }
+    return TopoDS_Shape();
+  }
+
+  // Planar half-spaces only. A boxed one is limited to its enclosure.
+  TopoDS_Shape halfSpace(const occ::handle<StepShape_HalfSpaceSolid>& theHalf,
+                         const Bnd_Box&                               theRegion) const
+  {
+    const auto aPlane =
+      occ::down_cast<Geom_Plane>(StepToGeom::MakeSurface(theHalf->BaseSurface(), myFactors));
+    if (aPlane.IsNull())
+    {
+      return TopoDS_Shape();
+    }
+    Bnd_Box      aRegion = theRegion;
+    TopoDS_Shape anEnclosure;
+    if (const auto aBoxed = occ::down_cast<StepShape_BoxedHalfSpace>(theHalf);
+        !aBoxed.IsNull() && !aBoxed->Enclosure().IsNull())
+    {
+      const auto& aDomain = aBoxed->Enclosure();
+      const auto  aCorner = StepToGeom::MakeCartesianPoint(aDomain->Corner(), myFactors);
+      if (!aCorner.IsNull())
+      {
+        anEnclosure = BRepPrimAPI_MakeBox(aCorner->Pnt(),
+                                          length(aDomain->Xlength()),
+                                          length(aDomain->Ylength()),
+                                          length(aDomain->Zlength()))
+                        .Shape();
+        aRegion.SetVoid();
+        BRepBndLib::Add(anEnclosure, aRegion);
+      }
+    }
+    if (aRegion.IsVoid())
+    {
+      return TopoDS_Shape();
+    }
+    // The material is on the side the plane's normal points away from if agreement_flag is TRUE.
+    const gp_Ax3 aPos  = aPlane->Position();
+    gp_Dir       aSide = aPos.Direction();
+    if (theHalf->AgreementFlag())
+    {
+      aSide.Reverse();
+    }
+    double aXmin, aYmin, aZmin, aXmax, aYmax, aZmax;
+    aRegion.Get(aXmin, aYmin, aZmin, aXmax, aYmax, aZmax);
+    const gp_Pnt aCentre((aXmin + aXmax) / 2, (aYmin + aYmax) / 2, (aZmin + aZmax) / 2);
+    const double aSize     = std::sqrt(aRegion.SquareExtent()) + Precision::Confusion();
+    const double aDistance = gp_Vec(aPos.Location(), aCentre).Dot(gp_Vec(aPos.Direction()));
