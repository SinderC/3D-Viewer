+namespace
+{
+// An operand of any of its types: solid model, half-space, CSG primitive or boolean result.
+// OCCT read solid models only, which left the CSG tree of most files empty.
+bool readOperand(const occ::handle<StepData_StepReaderData>& theData,
+                 const int                                   theNum,
+                 const int                                   theParam,
+                 const char*                                 theName,
+                 occ::handle<Interface_Check>&               theCheck,
+                 StepShape_BooleanOperand&                   theOperand)
+{
+  occ::handle<Standard_Transient> anEnt;
+  if (!theData->ReadEntity(theNum, theParam, theName, theCheck, STANDARD_TYPE(Standard_Transient), anEnt))
+  {
+    return false;
+  }
+  if (const auto aSolid = occ::down_cast<StepShape_SolidModel>(anEnt); !aSolid.IsNull())
+  {
+    theOperand.SetSolidModel(aSolid);
+  }
+  else if (const auto aHalf = occ::down_cast<StepShape_HalfSpaceSolid>(anEnt); !aHalf.IsNull())
+  {
+    theOperand.SetHalfSpaceSolid(aHalf);
+  }
+  else if (const auto aBool = occ::down_cast<StepShape_BooleanResult>(anEnt); !aBool.IsNull())
+  {
+    theOperand.SetBooleanResult(aBool);
+  }
+  else
+  {
+    StepShape_CsgPrimitive aPrimitive;
+    if (aPrimitive.CaseNum(anEnt) == 0)
+    {
+      theCheck->AddFail("Parameter is not a boolean_operand");
+      return false;
+    }
+    aPrimitive.SetValue(anEnt);
+    theOperand.SetCsgPrimitive(aPrimitive);
+  }
+  return true;
+}
+
+occ::handle<Standard_Transient> operandValue(const StepShape_BooleanOperand& theOperand)
+{
+  if (!theOperand.SolidModel().IsNull())
+  {
+    return theOperand.SolidModel();
+  }
+  if (!theOperand.HalfSpaceSolid().IsNull())
+  {
+    return theOperand.HalfSpaceSolid();
+  }
+  if (!theOperand.BooleanResult().IsNull())
+  {
+    return theOperand.BooleanResult();
+  }
+  return theOperand.CsgPrimitive().Value();
+}
