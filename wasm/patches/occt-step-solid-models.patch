+  // Planar faces to sweep, with their outer wires the right way round, and an edge for each
+  // segment of a polyline boundary: OCCT reads a polyline as one degree-1 B-spline, which would
+  // sweep to a single creased face that the mesher refines without end at its creases.
+  TopoDS_Face fixed(const TopoDS_Face& theFace) const
+  {
+    if (theFace.IsNull())
+    {
+      return theFace;
+    }
+    ShapeFix_Face aFix(theFace);
+    aFix.SetPrecision(myPrecision);
+    aFix.SetMaxTolerance(myMaxTol);
+    aFix.Perform();
+    ShapeUpgrade_ShapeDivideContinuity aSplit(aFix.Face());
+    aSplit.SetTolerance(myPrecision);
+    aSplit.SetBoundaryCriterion(GeomAbs_C1);
+    aSplit.SetPCurveCriterion(GeomAbs_C1);
+    if (!aSplit.Perform() || aSplit.Result().ShapeType() != TopAbs_FACE)
+    {
+      return aFix.Face();
+    }
+    return TopoDS::Face(aSplit.Result());
+  }
+
+  TopoDS_Face area(const occ::handle<StepGeom_CurveBoundedSurface>& theArea) const
+  {
+    StepToTopoDS_TranslateCurveBoundedSurface aTr;
+    return !theArea.IsNull() && aTr.Init(theArea, myTP, myFactors) ? fixed(aTr.Value())
+                                                                   : TopoDS_Face();
+  }
+
+  TopoDS_Face face(const occ::handle<StepShape_FaceSurface>& theFace) const
+  {
+    if (theFace.IsNull())
+    {
+      return TopoDS_Face();
+    }
+    StepToTopoDS_Tool                                                                       aTool;
+    NCollection_DataMap<occ::handle<StepShape_TopologicalRepresentationItem>, TopoDS_Shape> aMap;
+    aTool.Init(aMap, myTP);
+    StepToTopoDS_TranslateFace aTr;
+    aTr.SetPrecision(myPrecision);
+    aTr.SetMaxTol(myMaxTol);
+    StepToTopoDS_NMTool aNMTool;
+    aTr.Init(theFace, aTool, aNMTool, myFactors);
+    return aTr.IsDone() ? fixed(TopoDS::Face(aTr.Value())) : TopoDS_Face();
+  }
+
+  TopoDS_Shape extrude(const TopoDS_Face&                     theFace,
+                       const occ::handle<StepGeom_Direction>& theDir,
+                       const double                           theDepth) const
+  {
+    const auto aDir = StepToGeom::MakeDirection(theDir);
+    if (theFace.IsNull() || aDir.IsNull())
+    {
+      return TopoDS_Shape();
+    }
+    return BRepPrimAPI_MakePrism(theFace, gp_Vec(aDir->Dir()) * length(theDepth)).Shape();
+  }
+
+  // Positive angles turn by the right-hand rule about the axis, as ISO 10303-42 defines.
+  TopoDS_Shape revolve(const TopoDS_Face&                          theFace,
+                       const occ::handle<StepGeom_Axis1Placement>& theAxis,
+                       const double                                theAngle) const
+  {
+    if (theFace.IsNull())
+    {
+      return TopoDS_Shape();
+    }
+    return BRepPrimAPI_MakeRevol(theFace, ax1(theAxis), angle(theAngle)).Shape();
+  }
+
+  occ::handle<Transfer_TransientProcess> myTP;
+  StepData_Factors                       myFactors;
+  double                                 myPrecision;
+  double                                 myMaxTol;
+};
