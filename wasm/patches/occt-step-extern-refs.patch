+// Returns the 'data format' item of a document format representation, or null.
+static occ::handle<StepRepr_DescriptiveRepresentationItem> dataFormatItem(
+  const occ::handle<StepRepr_Representation>& theRep)
+{
+  static const occ::handle<TCollection_HAsciiString> THE_DATA_FORMAT =
+    new TCollection_HAsciiString("data format");
+  for (int i = 1; !theRep.IsNull() && i <= theRep->NbItems(); i++)
+  {
+    occ::handle<StepRepr_DescriptiveRepresentationItem> aDRI =
+      occ::down_cast<StepRepr_DescriptiveRepresentationItem>(theRep->ItemsValue(i));
+    if (!aDRI.IsNull() && !aDRI->Name().IsNull()
+        && aDRI->Name()->IsSameString(THE_DATA_FORMAT, false))
+    {
+      return aDRI;
+    }
+  }
+  return nullptr;
+}
