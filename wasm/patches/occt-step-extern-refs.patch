+bool STEPCAFControl_Reader::IsStepExternFormat(
+  const occ::handle<TCollection_HAsciiString>& theFormat)
+{
+  if (theFormat.IsNull())
+  {
+    return true;
+  }
+  TCollection_AsciiString aFormat = theFormat->String();
+  aFormat.LeftAdjust();
+  aFormat.RightAdjust();
+  aFormat.LowerCase();
+  if (aFormat.IsEmpty())
+  {
+    return true;
+  }
+  // Recommended values: CAx-IF External References 3.1, Table 2, and STEP File Compression 1.3,
+  // Figure 4. 'ISO 10303-242 Domain Model XML' is not a Part 21 file.
+  if (aFormat.Search("xml") > 0)
+  {
+    return false;
+  }
+  static const char* const THE_PREFIXES[] = {"step ap203",
+                                             "step ap214",
+                                             "step ap242",
+                                             "iso 10303-203",
+                                             "iso 10303-214",
+                                             "iso 10303-242"};
+  for (const char* const aPrefix : THE_PREFIXES)
+  {
+    if (aFormat.StartsWith(aPrefix))
+    {
+      return true;
+    }
+  }
+  return false;
+}
