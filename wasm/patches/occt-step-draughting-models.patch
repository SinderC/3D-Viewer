+} THE_TOLERANCE_TYPES[] = {{"ANGULARITY_TOLERANCE", StepDimTol_GTTAngularityTolerance},
+                           {"CIRCULAR_RUNOUT_TOLERANCE", StepDimTol_GTTCircularRunoutTolerance},
