+// Whether an entity is PMI that readAnnotation reads the presentation of
+static bool isSemanticGDT(const occ::handle<Standard_Transient>& theEnt)
+{
+  return !theEnt.IsNull()
+         && (theEnt->IsKind(STANDARD_TYPE(StepDimTol_Datum))
+             || theEnt->IsKind(STANDARD_TYPE(StepDimTol_DatumFeature))
+             || theEnt->IsKind(STANDARD_TYPE(StepDimTol_DatumTarget))
+             || theEnt->IsKind(STANDARD_TYPE(StepDimTol_GeometricTolerance))
+             || theEnt->IsKind(STANDARD_TYPE(StepShape_DimensionalSize))
+             || theEnt->IsKind(STANDARD_TYPE(StepShape_DimensionalLocation)));
+}
+
+// Whether the GDT object on a label has a presentation
+static bool hasPresentation(const TDF_Label& theGDTL)
+{
+  occ::handle<XCAFDoc_Dimension>     aDim;
+  occ::handle<XCAFDoc_GeomTolerance> aTol;
+  occ::handle<XCAFDoc_Datum>         aDat;
+  if (theGDTL.FindAttribute(XCAFDoc_Dimension::GetID(), aDim) && !aDim->GetObject().IsNull())
+  {
+    return !aDim->GetObject()->GetPresentation().IsNull();
+  }
+  if (theGDTL.FindAttribute(XCAFDoc_GeomTolerance::GetID(), aTol) && !aTol->GetObject().IsNull())
+  {
+    return !aTol->GetObject()->GetPresentation().IsNull();
+  }
+  return theGDTL.FindAttribute(XCAFDoc_Datum::GetID(), aDat) && !aDat->GetObject().IsNull()
+         && !aDat->GetObject()->GetPresentation().IsNull();
+}
