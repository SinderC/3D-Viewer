+
+#include <StepDimTol_GeometricToleranceType.hxx>
+#include <StepDimTol_GeometricToleranceWithDefinedAreaUnit.hxx>
+
+//! Complex instance of a geometric tolerance of some type with geometric_tolerance_with_defined_unit
+//! and, optionally, geometric_tolerance_with_defined_area_unit: a tolerance per unit length or area.
+class StepDimTol_GeoTolAndGeoTolWthDefUnit : public StepDimTol_GeometricToleranceWithDefinedAreaUnit
+{
+public:
+  Standard_EXPORT StepDimTol_GeoTolAndGeoTolWthDefUnit();
+
+  StepDimTol_GeometricToleranceType GetToleranceType() const { return myToleranceType; }
+
+  void SetToleranceType(const StepDimTol_GeometricToleranceType theType) { myToleranceType = theType; }
+
+  //! The unit size as written: a length_measure_with_unit, or a complex instance that includes
+  //! one (UnitSize() holds only the former)
+  const occ::handle<Standard_Transient>& UnitSizeMeasure() const { return myUnitSizeMeasure; }
+
+  void SetUnitSizeMeasure(const occ::handle<Standard_Transient>& theMeasure)
+  {
+    myUnitSizeMeasure = theMeasure;
+  }
+
+  //! The second unit size as written, if any (see UnitSizeMeasure())
+  const occ::handle<Standard_Transient>& SecondUnitSizeMeasure() const
+  {
+    return mySecondUnitSizeMeasure;
+  }
+
+  void SetSecondUnitSizeMeasure(const occ::handle<Standard_Transient>& theMeasure)
+  {
+    mySecondUnitSizeMeasure = theMeasure;
+  }
+
+  //! Whether the instance includes geometric_tolerance_with_defined_area_unit
+  bool HasAreaUnit() const { return myHasAreaUnit; }
+
+  void SetHasAreaUnit(const bool theHasAreaUnit) { myHasAreaUnit = theHasAreaUnit; }
+
+  DEFINE_STANDARD_RTTIEXT(StepDimTol_GeoTolAndGeoTolWthDefUnit,
+                          StepDimTol_GeometricToleranceWithDefinedAreaUnit)
+
+private:
+  StepDimTol_GeometricToleranceType myToleranceType;
+  bool                              myHasAreaUnit;
+  occ::handle<Standard_Transient>   myUnitSizeMeasure;
+  occ::handle<Standard_Transient>   mySecondUnitSizeMeasure;
+};
+#endif // _StepDimTol_GeoTolAndGeoTolWthDefUnit_HeaderFile
