+//=================================================================================================
+
+void RWStepDimTol_RWGeoTolAndGeoTolWthDefUnit::ReadStep(
+  const occ::handle<StepData_StepReaderData>&              data,
+  const int                                                num0,
+  occ::handle<Interface_Check>&                            ach,
+  const occ::handle<StepDimTol_GeoTolAndGeoTolWthDefUnit>& ent) const
+{
+  NCollection_Sequence<TCollection_AsciiString> aTypes;
+  data->ComplexType(num0, aTypes);
+  bool hasAreaUnit = false;
+  for (const TCollection_AsciiString& aName : aTypes)
+  {
+    hasAreaUnit = hasAreaUnit || aName == "GEOMETRIC_TOLERANCE_WITH_DEFINED_AREA_UNIT";
+    for (const auto& aType : THE_TOLERANCE_TYPES)
+    {
+      if (aName == aType.Name)
+      {
+        ent->SetToleranceType(aType.Type);
+      }
+    }
+  }
+  ent->SetHasAreaUnit(hasAreaUnit);
+
+  int num = 0;
+  data->NamedForComplex("GEOMETRIC_TOLERANCE", "GMTTLR", num0, num, ach);
+  if (!data->CheckNbParams(num, 4, ach, "geometric_tolerance"))
+  {
+    return;
+  }
+  occ::handle<TCollection_HAsciiString> aName;
+  data->ReadString(num, 1, "name", ach, aName);
+  occ::handle<TCollection_HAsciiString> aDescription;
+  data->ReadString(num, 2, "description", ach, aDescription);
+  occ::handle<Standard_Transient> aMagnitude;
+  data->ReadEntity(num, 3, "magnitude", ach, STANDARD_TYPE(Standard_Transient), aMagnitude);
+  StepDimTol_GeometricToleranceTarget aTolerancedShapeAspect;
+  data->ReadEntity(num, 4, "toleranced_shape_aspect", ach, aTolerancedShapeAspect);
+  ent->StepDimTol_GeometricTolerance::Init(aName, aDescription, aMagnitude, aTolerancedShapeAspect);
+
+  if (hasAreaUnit)
+  {
+    data->NamedForComplex("GEOMETRIC_TOLERANCE_WITH_DEFINED_AREA_UNIT", num0, num, ach);
+    if (data->CheckNbParams(num, 2, ach, "geometric_tolerance_with_defined_area_unit"))
+    {
+      const char* anArea = data->ParamType(num, 1) == Interface_ParamEnum ? data->ParamCValue(num, 1) : "";
+      for (const auto& aType : THE_AREA_TYPES)
+      {
+        if (strcmp(anArea, aType.Name) == 0)
+        {
+          ent->SetAreaType(aType.Type);
+        }
+      }
+      occ::handle<Standard_Transient> aSecondUnitSize;
+      if (data->IsParamDefined(num, 2))
+      {
+        data->ReadEntity(num,
+                         2,
+                         "second_unit_size",
+                         ach,
+                         STANDARD_TYPE(Standard_Transient),
+                         aSecondUnitSize);
+      }
+      ent->SetSecondUnitSizeMeasure(aSecondUnitSize);
+      ent->SetSecondUnitSize(occ::down_cast<StepBasic_LengthMeasureWithUnit>(aSecondUnitSize));
+    }
+  }
+
+  data->NamedForComplex("GEOMETRIC_TOLERANCE_WITH_DEFINED_UNIT", num0, num, ach);
+  if (data->CheckNbParams(num, 1, ach, "geometric_tolerance_with_defined_unit"))
+  {
+    // Also a complex length measure with a representation item, so read any entity
+    occ::handle<Standard_Transient> anUnitSize;
+    data->ReadEntity(num, 1, "unit_size", ach, STANDARD_TYPE(Standard_Transient), anUnitSize);
+    ent->SetUnitSizeMeasure(anUnitSize);
+    ent->SetUnitSize(occ::down_cast<StepBasic_LengthMeasureWithUnit>(anUnitSize));
+  }
+}
+
+//=================================================================================================
+
+void RWStepDimTol_RWGeoTolAndGeoTolWthDefUnit::WriteStep(
+  StepData_StepWriter&                                     SW,
+  const occ::handle<StepDimTol_GeoTolAndGeoTolWthDefUnit>& ent) const
+{
+  // Components in alphabetical order; the tolerance type sorts before or after the others
+  const char* aTypeName = "";
+  for (const auto& aType : THE_TOLERANCE_TYPES)
+  {
+    if (ent->GetToleranceType() == aType.Type)
+    {
+      aTypeName = aType.Name;
+    }
+  }
+  const bool isTypeFirst = strcmp(aTypeName, "GEOMETRIC_TOLERANCE") < 0;
+  if (isTypeFirst)
+  {
+    SW.StartEntity(aTypeName);
+  }
+  SW.StartEntity("GEOMETRIC_TOLERANCE");
+  SW.Send(ent->Name());
+  SW.Send(ent->Description());
+  SW.Send(ent->Magnitude());
+  SW.Send(ent->TolerancedShapeAspect().Value());
+  if (ent->HasAreaUnit())
+  {
+    SW.StartEntity("GEOMETRIC_TOLERANCE_WITH_DEFINED_AREA_UNIT");
+    for (const auto& aType : THE_AREA_TYPES)
+    {
+      if (ent->AreaType() == aType.Type)
+      {
+        SW.SendEnum(aType.Name);
+      }
+    }
+    if (ent->SecondUnitSizeMeasure().IsNull())
+    {
+      SW.SendUndef();
+    }
+    else
+    {
+      SW.Send(ent->SecondUnitSizeMeasure());
+    }
+  }
+  SW.StartEntity("GEOMETRIC_TOLERANCE_WITH_DEFINED_UNIT");
+  SW.Send(ent->UnitSizeMeasure());
+  if (!isTypeFirst)
+  {
+    SW.StartEntity(aTypeName);
+  }
